rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/memories/{imageId} {
      allow read, write: if request.auth != null
        && (request.auth.uid == uid
          || (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'caregiver'
            && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.patientId == uid
            && firestore.get(/databases/(default)/documents/users/$(uid)).data.caregiverIds.hasAny([request.auth.uid])));
    }
  }
}
